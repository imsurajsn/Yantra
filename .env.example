# Copy this file to .env and fill in the values below.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# REQUIRED. Signs session JWTs and derives the AES-256-GCM key that encrypts
# page auth-header secrets at rest. The app refuses to start without this.
# Generate one with: make generate-secret   (or: openssl rand -base64 32)
# ---------------------------------------------------------------------------
APP_SECRET=

# ---------------------------------------------------------------------------
# Database. DB_TYPE selects the GORM dialect: postgres | mysql | mariadb.
# The POSTGRES_* values below only configure the bundled Postgres container
# in docker-compose.yml — if you point DB_DSN at your own external
# Postgres/MySQL/MariaDB instance instead, they're unused.
# ---------------------------------------------------------------------------
DB_TYPE=postgres
POSTGRES_USER=yantra
POSTGRES_PASSWORD=changeme
POSTGRES_DB=yantra

# Full connection string the app uses to connect. Defaults below match the
# bundled Postgres container above — change host/user/password/dbname to
# point at your own instance. For DB_TYPE=mysql/mariadb use a MySQL-style
# DSN instead, e.g.: yantra:changeme@tcp(db:3306)/yantra?parseTime=true
DB_DSN=host=db user=yantra password=changeme dbname=yantra port=5432 sslmode=disable

# Host-side port the bundled Postgres container publishes on, bound to
# 127.0.0.1 only — use this to connect a local DB client (psql, DBeaver,
# TablePlus, etc.) directly to the database for inspection. Host: localhost,
# Port: this value, Database/User/Password: the POSTGRES_* values above.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Host port docker-compose publishes (the app always listens on 8080 inside
# the container).
PORT=8080

# Comma-separated IPs/CIDRs of reverse proxies (nginx/Caddy/Traefik) in
# front of Yantra, so audit-log IP addresses reflect the real client and not
# the proxy. Leave empty if Yantra is exposed directly with no proxy.
TRUSTED_PROXIES=

# Set to false ONLY for local plain-HTTP development (no TLS-terminating
# proxy in front yet). Every real deployment should leave this at true.
COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# Minutes of inactivity before a session expires (PRD default: 8 hours).
SESSION_INACTIVITY_MINUTES=480
