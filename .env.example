# ─── Required ───────────────────────────────────────────────────────────────
# Random secret used to sign JWTs and derive the AES-256 key for secret
# encryption. Generate with: openssl rand -hex 32
APP_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# ─── Database ────────────────────────────────────────────────────────────────
# DB_TYPE accepts: postgres | mysql | mariadb
DB_TYPE=postgres
DB_HOST=postgres        # Service name in docker-compose; use 'localhost' for external
DB_PORT=5432
DB_NAME=yantra
DB_USER=yantra
DB_PASSWORD=yantra
DB_SSL_MODE=disable     # Set to 'require' for production deployments

# Uncomment to expose the postgres port on your host machine (dev only)
# DB_EXPOSE_PORT=5432

# ─── Application ─────────────────────────────────────────────────────────────
PORT=8080
SESSION_DURATION_HOURS=8   # JWT session lifetime
BCRYPT_COST=12             # bcrypt work factor; increase for slower but more secure hashing
